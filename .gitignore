# -----------------------------------------------------------------------------
# Dados (não versionamos dados brutos grandes)
# -----------------------------------------------------------------------------
data/raw/*.csv
data/processed/*.csv
data/processed/*.npy
# Mantemos a estrutura de pastas
!data/raw/.gitkeep
!data/processed/.gitkeep

# -----------------------------------------------------------------------------
# Modelos Treinados (muito grandes para Git)
# Mantemos apenas o modelo usado em produção (models/lstm_vale3.h5)
# -----------------------------------------------------------------------------
models/*.keras

